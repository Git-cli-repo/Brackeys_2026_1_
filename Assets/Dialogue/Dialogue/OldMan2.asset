    talkSound: {fileID: 8300000, guid: 0f5e13045bbb1334f9dae418c1d34f79, type: 3}
  - talkLine: I came here to get some piece and quiet...
    talkSprite: {fileID: -6949200702322379995, guid: b562c4170e110054fb7b421b0f952f2c, type: 3}
    profileDirection: 0
    talkSound: {fileID: 8300000, guid: 0f5e13045bbb1334f9dae418c1d34f79, type: 3}
  - talkLine: But now all these annoying kids are hanging around!
    talkSprite: {fileID: -6949200702322379995, guid: b562c4170e110054fb7b421b0f952f2c, type: 3}
    profileDirection: 0
    talkSound: {fileID: 8300000, guid: 0f5e13045bbb1334f9dae418c1d34f79, type: 3}
  - talkLine: Is it really too much to ask to just shut up?!
    talkSprite: {fileID: -6949200702322379995, guid: b562c4170e110054fb7b421b0f952f2c, type: 3}
